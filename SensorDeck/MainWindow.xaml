<Window x:Class="SensorDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SensorDeck.ViewModels"
        Title="SensorDeck" Height="720" Width="1200" MinWidth="1040" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F7" FontFamily="Segoe UI" FontSize="13" Foreground="#1D2330">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="CardBg" Color="White"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E5EA"/>
        <SolidColorBrush x:Key="Muted" Color="#7A8394"/>
        <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>

        <!-- "+" toggle in front of every sensor -->
        <Style x:Key="AddToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Add to overlay"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" Background="#EEF2F8" BorderBrush="#D3DAE6" BorderThickness="1">
                            <TextBlock x:Name="Glyph" Text="+" FontSize="15" FontWeight="SemiBold" Foreground="#4A5568"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE6FA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6FEB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F6FEB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6FEB"/>
                                <Setter TargetName="Glyph" Property="Text" Value="✓"/>
                                <Setter TargetName="Glyph" Property="FontSize" Value="12"/>
                                <Setter TargetName="Glyph" Property="Margin" Value="0"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                                <Setter Property="ToolTip" Value="Remove from overlay"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5A6475"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="#2F6FEB" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245BD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Background" Value="#FFF6E5"/>
            <Setter Property="BorderBrush" Value="#F5D49A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="12,12,12,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- warnings -->
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource Banner}" Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Restart as administrator" Click="RestartAsAdmin_Click"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                        <Run FontWeight="SemiBold" Text="Not running as administrator."/>
                        <Run Text="CPU temperatures and motherboard fan speeds can't be read without it."/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Banner}" Visibility="{Binding ShowPawnIoWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding PawnIoButtonText}"
                            IsEnabled="{Binding CanInstallPawnIo}" Visibility="{Binding CanInstallPawnIoOrBusy, Converter={StaticResource BoolToVis}}"
                            Click="InstallPawnIo_Click"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                        <Run FontWeight="SemiBold" Text="{Binding PawnIoTitle, Mode=OneWay}"/>
                        <Run Text="{Binding PawnIoText, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Background="#ECEEF2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}">
                    <Run Text="Show/hide overlay:"/>
                    <Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1D2330"/>
                </TextBlock>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ============ all sensors ============ -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="16,14,16,10">
                        <Grid DockPanel.Dock="Right" Width="260">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" BorderBrush="{StaticResource CardBorder}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Search sensors…" Foreground="#A0A7B4" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="All sensors" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Click “+” to pin a sensor to the always-on-top overlay" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- column headers, aligned with the sensor rows below -->
                    <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1">
                        <Grid Margin="63,6,16,6" TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Sensor"/>
                            <TextBlock Grid.Column="2" Text="Current" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Min" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Max" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <TreeView x:Name="SensorTree" ItemsSource="{Binding Tree}" BorderThickness="0" Padding="4,6"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:HardwareNode}" ItemsSource="{Binding Groups}">
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                        <Border Background="#1D2330" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>

                                <HierarchicalDataTemplate DataType="{x:Type vm:GroupNode}" ItemsSource="{Binding Sensors}">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,2"/>
                                </HierarchicalDataTemplate>

                                <DataTemplate DataType="{x:Type vm:SensorNode}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource AddToggle}" IsChecked="{Binding IsInPanel}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MinText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Grid.Column="4" Text="{Binding MaxText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </DataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <TextBlock Text="Loading sensors…" Foreground="{StaticResource Muted}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ overlay panel ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="ToggleOverlay_Click" VerticalAlignment="Center">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Show"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                                                    <Setter Property="Text" Value="Hide"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Always-on-top overlay" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Click a name to rename it" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Panel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PanelItem}">
                                        <Border Padding="10,6,6,6" Margin="0,0,0,6" Background="#F7F8FA" CornerRadius="7" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                                         BorderThickness="0" Background="Transparent" Padding="0" Margin="-2,0,0,0"
                                                         ToolTip="Click to rename"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"/>
                                                <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding ValueText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="10,0,6,0" MinWidth="70" TextAlignment="Right"
                                                           Typography.NumeralAlignment="Tabular"/>
                                                <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="▲" FontSize="9" ToolTip="Move up" Click="MoveUp_Click"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="▼" FontSize="9" ToolTip="Move down" Click="MoveDown_Click"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="✕" FontSize="11" ToolTip="Remove from overlay" Click="Remove_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Nothing here yet.&#x0a;Click “+” next to a sensor on the left." TextAlignment="Center"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsPanelEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- settings -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Separator Margin="0,0,0,10" Background="{StaticResource CardBorder}"/>

                        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyText, Mode=OneWay}" IsReadOnly="True" Padding="8,5"
                                 Cursor="Hand" IsReadOnlyCaretVisible="False" BorderBrush="{StaticResource CardBorder}"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                 ToolTip="Click, then press a new key combination"/>
                        <TextBlock x:Name="HotkeyHint" Text="Click the field and press a combination, e.g. Ctrl + Alt + H" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding HotkeyError}" Foreground="#D93636" FontSize="11" TextWrapping="Wrap"/>

                        <CheckBox IsChecked="{Binding ClickThrough}" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Lock overlay" FontWeight="SemiBold"/>
                                <Run Text="(clicks pass through it)" Foreground="#7A8394"/>
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="While unlocked, you can drag the overlay with the mouse." Foreground="{StaticResource Muted}" FontSize="11" Margin="20,2,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Font size" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="10" Maximum="32" Value="{Binding OverlayFontSize}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock Grid.Column="2" Text="{Binding OverlayFontSize}" TextAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="Background" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
