<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>SensorDeck</AssemblyTitle>
    <Product>SensorDeck</Product>
    <Version>0.1.1</Version>
    <!-- DPI awareness is declared in app.manifest on purpose (WPF needs it there) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for the tray icon; keep its names out of the global namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official signed PawnIO 2.2.0 installer (github.com/namazso/PawnIO.Setup), SHA256 1F519A22...FBA3032.
         When updating LibreHardwareMonitorLib, check whether a newer driver is required and replace this file
         together with PawnIoInstaller.BundledVersion. -->
    <EmbeddedResource Include="Resources\PawnIO_setup.exe" LogicalName="SensorDeck.PawnIO_setup.exe" />
  </ItemGroup>

</Project>
